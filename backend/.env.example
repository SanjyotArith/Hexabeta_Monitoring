# ======================================================
# HexaAgent Configuration
# ======================================================
# Copy this file to .env and update the values.
# ======================================================

# --- HexaBeta Project Paths ---
HEXABETA_PROJECT_ROOT=/Users/hexabeta/projects/arithwise-HBv1
HEXABETA_BACKEND_PATH=/Users/hexabeta/projects/arithwise-HBv1/backend
HEXABETA_FRONTEND_PATH=/Users/hexabeta/projects/arithwise-HBv1/frontend
HEXABETA_UPLOADS_PATH=/Users/hexabeta/projects/arithwise-HBv1/backend/static/uploads

# --- HexaBeta Backend ---
HEXABETA_BACKEND_PORT=8002

# --- Agent Settings ---
REFRESH_INTERVAL=5
HOST=0.0.0.0
PORT=9000

# --- Reporter Settings ---
MONITOR_URL=https://hexamonitor.spicykheer.com
API_PREFIX=/api/v1
REPORT_ENDPOINT=/agents/report
SNAPSHOT_PUSH_ENDPOINT=/snapshot/push
AGENT_KEY=HM_1b1eb4522af9cf2df17356e013dfdd739d58f5c342f8a2fe8e11fb4ed12bb612
MACHINE_NAME=MacHexa
PROJECT_NAME=HexaBeta
ENVIRONMENT=production
COLLECTION_INTERVAL=60
REQUEST_TIMEOUT=10.0
VERIFY_SSL=true
LOG_LEVEL=INFO
DEBUG=false

# --- Phase 2A: Backend Provider ---
BACKEND_INTERNAL_HEALTH_URL=http://localhost:8002/api/health
BACKEND_EXTERNAL_HEALTH_URL=https://hexabeta.com/api/health
BACKEND_LAUNCH_LABEL=com.hexa.backend

# --- Docker Awareness ---
# Enable Docker container detection (safe on macOS — degrades gracefully)
DOCKER_ENABLED=true
# Detection mode: "auto" (try host first, then Docker), "host", or "docker"
BACKEND_MODE=auto
# Comma-separated container name patterns for HexaBeta backend
HEXABETA_BACKEND_CONTAINER_PATTERNS=hexabeta_backend,hexabeta_backend_green
# Timeout in seconds for Docker CLI commands
DOCKER_COMMAND_TIMEOUT=5

# --- Phase 2A: PostgreSQL Provider ---
POSTGRES_SERVICE=postgresql@17
POSTGRES_PORT=5432
POSTGRES_DATABASE=loops_db
POSTGRES_USER=hexa_user
POSTGRES_PASSWORD=

# --- Phase 2A: Redis Provider ---
REDIS_SERVICE=redis
REDIS_PORT=6379

# --- Phase 2A: Nginx Provider ---
NGINX_LABEL=com.hexabeta.nginx
NGINX_HTTP=http://127.0.0.1
NGINX_HTTPS=https://127.0.0.1

# --- Phase 2A: Cloudflared Provider ---
CLOUDFLARED_TUNNEL=mac-mini

# --- Phase 2A: Git Provider ---
GIT_PROJECT_PATH=/Users/hexabeta/projects/arithwise-HBv1

# --- Phase 2A: Deploy (read-only reference) ---
DEPLOY_SCRIPT=/Users/hexabeta/hb-deploy.sh

# --- Phase 2A: Snapshot Engine ---
SNAPSHOT_INTERVAL=5

# --- Phase 2B: Security Settings ---
# Secure Operation Token required to perform POST operational actions
OPERATION_TOKEN=Hb123456789

# --- Phase 2B: Log File Paths ---
BACKEND_LOG_PATH=/Users/hexabeta/backend.log
BACKEND_ERROR_LOG_PATH=/Users/hexabeta/backend-error.log
NGINX_LOG_PATH=/opt/homebrew/var/log/nginx/access.log
NGINX_ERROR_LOG_PATH=/opt/homebrew/var/log/nginx/error.log
REDIS_LOG_PATH=/opt/homebrew/var/log/redis.log
POSTGRES_LOG_PATH=/opt/homebrew/var/postgresql@17/log/
CLOUDFLARED_LOG_PATH=/Users/hexabeta/.cloudflared/cloudflared.log
DEPLOYMENT_LOG_PATH=/Users/hexabeta/hb-deploy.log

# --- Phase 2B: Alert Thresholds ---
ALERT_CPU_THRESHOLD=80.0
ALERT_MEMORY_THRESHOLD=90.0
ALERT_DISK_THRESHOLD=85.0
ALERT_GPU_THRESHOLD=85.0

# --- Phase 2B: History Engine ---
HISTORY_SAVE_INTERVAL=300

